<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景色（比整体 widget 略深一点） -->
    <solid android:color="#F5F5F5"/>

    <!-- 圆角 -->
    <corners android:radius="8dp"/>

    <!-- 轻微分隔边框（可选） -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0"/>

    <!-- 内边距 -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp"/>
</shape>
